{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Configure Codeforces handle",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/setup_codeforces.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Configure weekly push",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/setup_daily_automation.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Codeforces Accepted watcher",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/codeforces_watcher.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "CP: Mark current problem accepted (non-Codeforces)",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/mark_current_accepted.py", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Push pending solutions now",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/weekly_push.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Finish current problem (manual fallback)",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/finish_current_problem.py", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Configure historical folders",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--configure"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Preview all historical solutions",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--preview"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Import previewed historical solutions",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--import"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
