{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Configure Codeforces handle",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/setup_codeforces.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Configure historical folders",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--configure"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Archive accepted solution",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/archive_solution.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Archive and push accepted solution",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/archive_solution.py", "--push"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Preview all historical solutions",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--preview"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CP: Import previewed historical solutions",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/tools/import_history_v2.py", "--import"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
